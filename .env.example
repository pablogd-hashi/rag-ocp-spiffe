# Qdrant Cloud — copy to .env and fill in your values
QDRANT_URL=https://<cluster-id>.<region>.gcp.cloud.qdrant.io
QDRANT_API_KEY=<your-api-key>

# Ollama — local or OCP service
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=phi3

# Collection defaults
COLLECTION=platform-docs
TOP_K=5
TENANT=default
